# -----------------------------------------------------------------------------
# Akeyless Gateway .env
# Purpose: keep values here; docker compose / k8s manifests read from this file.
# Docs: https://docs.akeyless.io/docs
# NOTE: JSON-like values should remain a single line with no spaces unless quoted.
# -----------------------------------------------------------------------------

# ===== 1) Core cluster & mode =====
# Must match your Akeyless cluster name
CLUSTER_NAME=
# Enable unified Gateway mode (SRA + Gateway in one pod)
UNIFIED_GATEWAY=true
# Optional: set a specific image tag; empty = pull default/latest
VERSION=

# ===== 2) Observability =====
# "true" to expose Gateway metrics (Prometheus scrape, etc.)
ENABLE_METRICS=false

# ===== 3) Authentication to Akeyless (required) =====
# The Access ID to authenticate the Gateway
GATEWAY_ACCESS_ID=
# REQUIRED for SRA. One of: access_key/password/saml/ldap/k8s/azure_ad/oidc/aws_iam/universal_identity/jwt/gcp/cert/oci/kerberos
GATEWAY_ACCESS_TYPE=
# Access key/secret/token as applicable to the access type
GATEWAY_ACCESS_KEY=

# ===== 4) Delegated / scoped access =====
# A list of Access IDs and their permissions the Gateway may act on behalf of.
ALLOWED_ACCESS_PERMISSIONS=[{"name":"..","access_id":"..","permissions":["admin"]}]

# ===== 5) TLS manager / configuration =====
# Enables TLS configuration management for the Gateway
# If you manage TLS externally (ingress/proxy) leave volumes unmounted for cert/key.
# If set to true, ensure the corresponding cert/key configuration is provided.
ENABLE_TLS_CONFIGURE=true

# ===== 6) Caching controls =====
# If you want to turn OFF caching for Gateway without SRA, leave the GATEWAY_CLUSTER_CACHE empty. Note SRA must use Cache service
# Cluster cache toggle for Gateway ("enable"/"disable")
GATEWAY_CLUSTER_CACHE=enable
# Use Redis-backed cluster cache
USE_CLUSTER_CACHE=true
# Prefer cached reads before remote fetch where applicable
PREFER_CLUSTER_CACHE_FIRST=true
# Legacy/alt flag – keep as provided
PROACTIVE_CACHE_ENABLE=false
# Newer proactive cache flag – keep as provided
NEW_PROACTIVE_CACHE_ENABLE=true
# Alias/legacy flag – keep as provided
PRO_ACTIVE_CACHE_ENABLE=true
#CUSTOMER_FRAGMENTS='{"customer_fragments": [{"id": "cf-*************","value": "4zm7UXxpkm********************************************XuOAI3riEA=="}]}'
#ENABLE_CACHE_TLS="false"
# ^ These proactive flags can overlap across versions. Keep as-is unless support instructs otherwise.

# ===== 7) Redis (internal network only when cache is enabled) =====
# Host:port for Redis (use internal DNS/service)
REDIS_ADDR=akeyless-cache:6379

# ===== 8) Default SRA Gateway Section  =====
REMOTE_ACCESS_WEB_SERVICE_INTERNAL_URL=http://akeyless-sra-web:8888
REMOTE_ACCESS_SSH_SERVICE_INTERNAL_URL=http://akeyless-sra-ssh:9900

# AKEYLESS_URL=https://vault.us.akeyless.io

# -----------------------------------------------------------------------------
# End of file
# -----------------------------------------------------------------------------